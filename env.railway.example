# Configuración para Railway (producción)
APP_NAME=FastAPI Trading System
APP_VERSION=1.0.0
DEBUG=false

# Base de datos (Railway proporciona automáticamente DATABASE_URL para PostgreSQL)
# Si no hay PostgreSQL, usar SQLite
DATABASE_URL=sqlite:///./prod.db
REDIS_URL=redis://localhost:6379

# Seguridad
SECRET_KEY=your-production-secret-key-change-this-immediately
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Scheduler habilitado
ENABLE_SCHEDULER=true

# Notificaciones (configurar en Railway variables de entorno)
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
FIREBASE_CREDENTIALS_PATH=

# Celery (si se usa Redis de Railway)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Servidor
HOST=0.0.0.0
PORT=8000
WORKERS=1
